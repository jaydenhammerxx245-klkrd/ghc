{ "idEmpleado": 1, "nombre": "Eva", "apellido": "Ruiz", "cedula": "002", "telefono": "809-555-0202", "cargo": "Gerente", "salario": 55000, "correo": "eva@example.com" }

###
DELETE {{base}}/EmpleadoApi/1

############ HABITACION ############
POST {{base}}/HabitacionApi
Content-Type: application/json

{ "numero": "101", "capacidad": 2, "precioNoche": 80, "disponible": true, "idPiso": 1, "precio": 80, "tipo": "Doble", "estado": "Libre" }

###
POST {{base}}/HabitacionApi
Content-Type: application/json

{ "numero": "102", "capacidad": 4, "precioNoche": 120, "disponible": false, "idPiso": 1, "precio": 120, "tipo": "Suite", "estado": "Mantenimiento" }

###
GET {{base}}/HabitacionApi

###
GET {{base}}/HabitacionApi/1

###
PUT {{base}}/HabitacionApi/1
Content-Type: application/json

{ "idHabitacion": 1, "numero": "101", "capacidad": 3, "precioNoche": 80, "disponible": true, "idPiso": 1, "precio": 80, "tipo": "Triple", "estado": "Libre" }

###
DELETE {{base}}/HabitacionApi/99

############ USUARIO (la respuesta nunca incluye la clave) ############
POST {{base}}/UsuarioApi
Content-Type: application/json

{ "nombreUsuario": "admin", "clave": "S3creta!", "rol": "Administrador" }

###
GET {{base}}/UsuarioApi

###
GET {{base}}/UsuarioApi/1

###
PUT {{base}}/UsuarioApi/1
Content-Type: application/json

{ "idUsuario": 1, "nombreUsuario": "admin", "clave": "Nueva!", "rol": "Supervisor" }

###
DELETE {{base}}/UsuarioApi/99

############ RESERVA ############
### Exitosa -> 201, total = 3 noches x 80 = 240
POST {{base}}/ReservaApi
Content-Type: application/json

{ "idCliente": 1, "idHabitacion": 1, "fechaEntrada": "2026-12-01", "fechaSalida": "2026-12-04" }

### Rechazada -> 422 (se solapa con la anterior)
POST {{base}}/ReservaApi
Content-Type: application/json

{ "idCliente": 1, "idHabitacion": 1, "fechaEntrada": "2026-12-03", "fechaSalida": "2026-12-06" }

### Rechazada -> 422 (salida antes de la entrada)
POST {{base}}/ReservaApi
Content-Type: application/json

{ "idCliente": 1, "idHabitacion": 1, "fechaEntrada": "2026-12-10", "fechaSalida": "2026-12-08" }

### Rechazada -> 422 (habitación no disponible)
POST {{base}}/ReservaApi
Content-Type: application/json

{ "idCliente": 1, "idHabitacion": 2, "fechaEntrada": "2026-12-10", "fechaSalida": "2026-12-12" }

###
GET {{base}}/ReservaApi

###
GET {{base}}/ReservaApi/1

### Actualiza fechas -> total recalculado a 400
PUT {{base}}/ReservaApi/1
Content-Type: application/json

{ "idReserva": 1, "idCliente": 1, "idHabitacion": 1, "fechaEntrada": "2026-12-01", "fechaSalida": "2026-12-06" }

###
DELETE {{base}}/ReservaApi/1

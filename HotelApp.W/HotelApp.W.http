### Pruebas de la API de Hotel Crown
### Abrir en Visual Studio o VS Code (extensión REST Client) y pulsar "Send Request" en cada bloque.
### Antes: cd HotelApp.W && dotnet run --launch-profile http

@base = http://localhost:5280/api

############ BUILD (edificios) ############
POST {{base}}/BuildApi
Content-Type: application/json

{ "nombre": "Torre A", "descripcion": "Edificio principal", "cantidadPisos": 5 }

###
GET {{base}}/BuildApi

###
GET {{base}}/BuildApi/1

###
PUT {{base}}/BuildApi/1
Content-Type: application/json

{ "idBuild": 1, "nombre": "Torre A", "descripcion": "Remodelado", "cantidadPisos": 6 }

###
DELETE {{base}}/BuildApi/99

############ PISO ############
POST {{base}}/PisoApi
Content-Type: application/json

{ "numeroPiso": 1, "idBuild": 1, "nombre": "Primer piso" }

###
GET {{base}}/PisoApi

###
GET {{base}}/PisoApi/1

###
PUT {{base}}/PisoApi/1
Content-Type: application/json

{ "idPiso": 1, "numeroPiso": 1, "idBuild": 1, "nombre": "Planta baja" }

###
DELETE {{base}}/PisoApi/1

############ CLIENTE ############
POST {{base}}/ClienteApi
Content-Type: application/json

{ "nombre": "Luis", "apellido": "Paz", "cedula": "001-0000001-1", "telefono": "809-555-0101", "correo": "luis@example.com" }

###
GET {{base}}/ClienteApi

###
GET {{base}}/ClienteApi/1

###
PUT {{base}}/ClienteApi/1
Content-Type: application/json

{ "idCliente": 1, "nombre": "Luis", "apellido": "Paz", "cedula": "001-0000001-1", "telefono": "809-555-0199", "correo": "luis@example.com" }

###
DELETE {{base}}/ClienteApi/99

############ EMPLEADO ############
POST {{base}}/EmpleadoApi
Content-Type: application/json

{ "nombre": "Eva", "apellido": "Ruiz", "cedula": "002", "telefono": "809-555-0202", "cargo": "Recepcionista", "salario": 35000, "correo": "eva@example.com" }

###
GET {{base}}/EmpleadoApi

###
GET {{base}}/EmpleadoApi/1

###
PUT {{base}}/EmpleadoApi/1

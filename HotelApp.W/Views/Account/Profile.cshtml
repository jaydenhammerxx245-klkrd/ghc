@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="container mt-4">

    <div class="card">

        <div class="card-header">
            Información del Usuario
        </div>

        <div class="card-body">

            <p>
                <strong>Usuario:</strong>
                @User.Identity?.Name
            </p>

            <p>
                <strong>Rol:</strong>
                Administrador
            </p>

            <p>
                <strong>Sistema:</strong>
                Hotel Crown
            </p>

        </div>

    </div>

</div>
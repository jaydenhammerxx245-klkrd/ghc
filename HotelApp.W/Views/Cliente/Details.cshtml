@model HotelManagement.Entities.Cliente

<h2>Detalle del Cliente</h2>

<div class="card">
    <div class="card-body">

        <p>
            <strong>ID:</strong>
            @Model.IdCliente
        </p>

        <p>
            <strong>Nombre:</strong>
            @Model.Nombre
        </p>

        <p>
            <strong>Apellido:</strong>
            @Model.Apellido
        </p>

        <p>
            <strong>Cédula:</strong>
            @Model.Cedula
        </p>

        <p>
            <strong>Teléfono:</strong>
            @Model.Telefono
        </p>

        <p>
            <strong>Correo:</strong>
            @Model.Correo
        </p>

    </div>
</div>

<br />

<a asp-action="Index" class="btn btn-secondary">
    Go back to List
</a>
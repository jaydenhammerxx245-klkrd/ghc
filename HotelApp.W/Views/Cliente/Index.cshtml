@model IEnumerable<HotelManagement.Entities.Cliente>

<h2>Lista de Clientes</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Cliente
    </a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Apellido</th>
            <th>Cédula</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.IdCliente</td>
                <td>@item.Nombre</td>
                <td>@item.Apellido</td>
                <td>@item.Cedula</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>

                <td>
                    <a asp-action="Details" asp-route-id="@item.IdCliente">Ver</a> |
                    <a asp-action="Edit" asp-route-id="@item.IdCliente">Editar</a> |
                    <a asp-action="Delete" asp-route-id="@item.IdCliente">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

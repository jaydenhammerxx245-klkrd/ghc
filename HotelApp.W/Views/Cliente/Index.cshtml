@model IEnumerable<HotelManagement.Entities.Cliente>
@{
    ViewData["Title"] = "Clientes";
}

<partial name="_Banner" model='new BannerViewModel("Clientes", "Huéspedes registrados en el hotel.", "~/Imagenes/Hotel/web/habitacion-suite.jpg", "Nuevo cliente")' />

@if (!Model.Any())
{
    <div class="hc-vacio">Todavía no hay clientes registrados.</div>
}
else
{
    <div class="hc-tabla table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdCliente</td>
                        <td class="fw-semibold">@item.Nombre @item.Apellido</td>
                        <td>@item.Cedula</td>
                        <td>@item.Telefono</td>
                        <td>@item.Correo</td>
                        <td class="text-end hc-acciones">
                            <a asp-action="Details" asp-route-id="@item.IdCliente" class="btn btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdCliente" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdCliente" class="btn btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

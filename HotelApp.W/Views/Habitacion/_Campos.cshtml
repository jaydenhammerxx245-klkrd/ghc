@model HotelManagement.Entities.Habitacion
@* Campos comunes de Crear y Editar: se envían TODOS para no perder datos al actualizar. *@

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Numero" class="form-label">Número</label>
        <input asp-for="Numero" class="form-control" />
        <span asp-validation-for="Numero" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="IdPiso" class="form-label">Piso</label>
        <select asp-for="IdPiso" asp-items="ViewBag.Pisos" class="form-select">
            <option value="0">Seleccionar piso</option>
        </select>
        <span asp-validation-for="IdPiso" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Capacidad" class="form-label">Capacidad (personas)</label>
        <input asp-for="Capacidad" class="form-control" />
        <span asp-validation-for="Capacidad" class="text-danger"></span>
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="PrecioNoche" class="form-label">Precio por noche</label>
        <input asp-for="PrecioNoche" class="form-control" />
        <span asp-validation-for="PrecioNoche" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Precio" class="form-label">Precio de lista</label>
        <input asp-for="Precio" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Tipo" class="form-label">Tipo</label>
        <input asp-for="Tipo" class="form-control" placeholder="Doble, Suite…" />
    </div>
</div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Estado" class="form-label">Estado</label>
        <input asp-for="Estado" class="form-control" placeholder="Libre, Mantenimiento…" />
    </div>

    <div class="col-md-4 mb-3 form-check mt-4 ms-3">
        <input asp-for="Disponible" class="form-check-input" type="checkbox" />
        <label asp-for="Disponible" class="form-check-label">Disponible para reservar</label>
    </div>
</div>

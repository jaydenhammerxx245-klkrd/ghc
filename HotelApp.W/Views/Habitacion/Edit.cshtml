@model HotelApp.W.Models.HabitacionViewModel

<h2>Editar Habitación</h2>

<form asp-action="Edit">

    <input type="hidden" asp-for="IdHabitacion" />

    <div class="mb-3">
        <label asp-for="Numero"></label>
        <input asp-for="Numero" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Capacidad"></label>
        <input asp-for="Capacidad" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="PrecioNoche"></label>
        <input asp-for="PrecioNoche" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Disponible"></label>
        <input asp-for="Disponible" type="checkbox" />
    </div>

    <button type="submit" class="btn btn-warning">
        Actualizar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>
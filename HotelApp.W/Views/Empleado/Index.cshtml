@model IEnumerable<HotelManagement.Entities.Empleado>
@{
    ViewData["Title"] = "Empleados";
}

<partial name="_Banner" model='new BannerViewModel("Empleados", "Personal del hotel: recepción, restaurante, mantenimiento y administración.", "~/Imagenes/Hotel/web/restaurante.jpg", "Nuevo empleado")' />

@if (!Model.Any())
{
    <div class="hc-vacio">Todavía no hay empleados registrados.</div>
}
else
{
    <div class="hc-tabla table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Cédula</th>
                    <th>Cargo</th>
                    <th>Teléfono</th>
                    <th>Correo</th>
                    <th class="text-end">Salario</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdEmpleado</td>
                        <td class="fw-semibold">@item.Nombre @item.Apellido</td>
                        <td>@item.Cedula</td>
                        <td>@item.Cargo</td>
                        <td>@item.Telefono</td>
                        <td>@item.Correo</td>
                        <td class="text-end">@item.Salario.ToString("N2")</td>
                        <td class="text-end hc-acciones">
                            <a asp-action="Details" asp-route-id="@item.IdEmpleado" class="btn btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdEmpleado" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdEmpleado" class="btn btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

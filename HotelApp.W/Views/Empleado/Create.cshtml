@model HotelManagement.Entities.Empleado

<h2>Crear Empleado</h2>

<form asp-action="Create">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nombre"></label>
        <input asp-for="Nombre" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Apellido"></label>
        <input asp-for="Apellido" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Cedula"></label>
        <input asp-for="Cedula" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Telefono"></label>
        <input asp-for="Telefono" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Cargo"></label>
        <input asp-for="Cargo" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Salario"></label>
        <input asp-for="Salario" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" type="email" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>

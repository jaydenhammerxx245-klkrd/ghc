@model HotelManagement.Entities.Usuario

<h2>Crear Usuario</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Rol"></label>
        <input asp-for="Rol" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>

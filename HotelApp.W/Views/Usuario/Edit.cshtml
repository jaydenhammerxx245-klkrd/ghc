@model HotelManagement.Entities.Usuario

<h2>Editar Usuario</h2>

<form asp-action="Edit">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="IdUsuario" />

    <div class="mb-3">
        <label asp-for="NombreUsuario"></label>
        <input asp-for="NombreUsuario" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" type="password" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Rol"></label>
        <input asp-for="Rol" class="form-control" />
    </div>

    <button type="submit" class="btn btn-warning">
        Actualizar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>
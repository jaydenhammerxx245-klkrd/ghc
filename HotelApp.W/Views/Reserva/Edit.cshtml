@model HotelManagement.Entities.Reserva

<h2>Editar Reserva</h2>

<form asp-action="Edit">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="IdReserva" />

    <div class="mb-3">
        <label asp-for="IdCliente"></label>
        <input asp-for="IdCliente" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="IdHabitacion"></label>
        <input asp-for="IdHabitacion" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaEntrada"></label>
        <input asp-for="FechaEntrada" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaSalida"></label>
        <input asp-for="FechaSalida" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Total"></label>
        <input asp-for="Total" class="form-control" readonly />
        <small class="text-muted">Se calcula automáticamente: noches × precio por noche.</small>
    </div>

    <button type="submit" class="btn btn-warning">
        Actualizar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>
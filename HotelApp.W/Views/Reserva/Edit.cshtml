@model HotelManagement.Entities.Reserva
@{
    ViewData["Title"] = "Editar reserva";
}

<h2>Editar reserva #@Model.IdReserva</h2>

<form asp-action="Edit">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden" asp-for="IdReserva" />

    <partial name="_Campos" model="Model" />

    <div class="mb-3">
        <label asp-for="Total" class="form-label"></label>
        <input asp-for="Total" class="form-control" readonly />
        <small class="text-muted">Se recalcula automáticamente al guardar: noches × precio por noche.</small>
    </div>

    <button type="submit" class="btn btn-dorado">
        Actualizar
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>

</form>

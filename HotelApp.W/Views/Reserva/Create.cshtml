@model HotelApp.W.Models.ReservaViewModel

<h2>Crear Reserva</h2>

<form asp-action="Create">

    <div class="mb-3">
        <label asp-for="IdCliente"></label>
        <input asp-for="IdCliente" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="IdHabitacion"></label>
        <input asp-for="IdHabitacion" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaEntrada"></label>
        <input asp-for="FechaEntrada" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="FechaSalida"></label>
        <input asp-for="FechaSalida" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Total"></label>
        <input asp-for="Total" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>
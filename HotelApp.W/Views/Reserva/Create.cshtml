@model HotelManagement.Entities.Reserva
@{
    ViewData["Title"] = "Nueva reserva";
}

<h2>Nueva reserva</h2>

<form asp-action="Create">

    <div asp-validation-summary="All" class="text-danger"></div>

    <partial name="_Campos" model="Model" />

    <p class="text-muted">El total se calcula automáticamente: noches × precio por noche de la habitación.
        El sistema rechaza la reserva si la habitación no está disponible o ya está ocupada en esas fechas.</p>

    <button type="submit" class="btn btn-dorado">
        Guardar reserva
    </button>

    <a asp-action="Index" class="btn btn-outline-secondary">
        Volver
    </a>

</form>

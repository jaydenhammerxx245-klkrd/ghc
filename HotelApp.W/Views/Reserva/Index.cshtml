@model IEnumerable<HotelManagement.Entities.Reserva>
@{
    ViewData["Title"] = "Reservas";
}

<partial name="_Banner" model='new BannerViewModel("Reservas", "Estadías registradas. El total se calcula automáticamente: noches × precio por noche.", "~/Imagenes/Hotel/web/recepcion.jpg", "Nueva reserva")' />

@if (!Model.Any())
{
    <div class="hc-vacio">Todavía no hay reservas registradas.</div>
}
else
{
    <div class="hc-tabla table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Habitación</th>
                    <th>Entrada</th>
                    <th>Salida</th>
                    <th>Noches</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.IdReserva</td>
                        <td>@item.IdCliente</td>
                        <td>@item.IdHabitacion</td>
                        <td>@item.FechaEntrada.ToString("dd/MM/yyyy")</td>
                        <td>@item.FechaSalida.ToString("dd/MM/yyyy")</td>
                        <td>@item.Noches</td>
                        <td class="text-end fw-semibold">@item.Total.ToString("N2")</td>
                        <td class="text-end hc-acciones">
                            <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

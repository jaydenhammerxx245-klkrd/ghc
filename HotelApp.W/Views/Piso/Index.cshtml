@model IEnumerable<HotelManagement.Entities.Piso>
@{
    ViewData["Title"] = "Pisos";
}

<partial name="_Banner" model='new BannerViewModel("Pisos", "Pisos de cada edificio, donde se ubican las habitaciones.", null, "Nuevo piso")' />

@if (!Model.Any())
{
    <div class="hc-vacio">Todavía no hay pisos registrados.</div>
}
else
{
    <div class="hc-tabla table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Número de piso</th>
                    <th>Nombre</th>
                    <th>Edificio</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.IdPiso</td>
                        <td>@item.NumeroPiso</td>
                        <td class="fw-semibold">@item.Nombre</td>
                        <td>@item.IdBuild</td>
                        <td class="text-end hc-acciones">
                            <a asp-action="Details" asp-route-id="@item.IdPiso" class="btn btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@item.IdPiso" class="btn btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.IdPiso" class="btn btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@model HotelManagement.Entities.Piso
@{
    ViewData["Title"] = "Crear Piso";
}

<h2>Crear Piso</h2>

<form asp-action="Create">

    <div class="mb-3">

        <label asp-for="NumeroPiso"
               class="form-label">
        </label>

        <input asp-for="NumeroPiso"
               class="form-control" />

        <span asp-validation-for="NumeroPiso"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Nombre"
               class="form-label">
        </label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label class="form-label">
            Bloque
        </label>

        <select asp-for="IdBuild"
                asp-items="ViewBag.Builds"
                class="form-control">

            <option value="">
                Seleccionar Bloque
            </option>

        </select>

    </div>

    <button type="submit"
            class="btn btn-success">

        Guardar

    </button>

    <a asp-action="Index"
       class="btn btn-secondary">

        Volver

    </a>

</form>

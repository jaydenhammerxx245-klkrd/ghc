@model HotelManagement.Entities.Build

@{
    ViewData["Title"] = "Editar Bloque";
}

<h2>Editar Bloque</h2>

<form asp-action="Edit">

    <div asp-validation-summary="All" class="text-danger"></div>

    <input type="hidden"
           asp-for="IdBuild" />

    <div class="mb-3">

        <label asp-for="Nombre"
               class="form-label"></label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Descripcion"
               class="form-label"></label>

        <input asp-for="Descripcion"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="CantidadPisos"
               class="form-label"></label>

        <input asp-for="CantidadPisos"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">
        Actualizar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>
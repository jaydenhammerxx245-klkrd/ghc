@model IEnumerable<HotelApp.W.Models.BuildViewModel>

@{
    ViewData["Title"] = "Bloques";
}

<h2>Listado de Bloques</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">
        Nuevo Bloque
    </a>
</p>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Cantidad de Pisos</th>
            <th>Acciones</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>

                <td>@item.Nombre</td>

                <td>@item.Descripcion</td>

                <td>@item.CantidadPisos</td>

                <td>

                    <a asp-action="Edit"
                       asp-route-id="@item.IdBuild"
                       class="btn btn-warning">
                        Editar
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.IdBuild"
                       class="btn btn-info">
                        Detalles
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>
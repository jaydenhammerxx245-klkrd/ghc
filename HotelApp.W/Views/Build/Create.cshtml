@model HotelManagement.Entities.Build

@{
    ViewData["Title"] = "Crear Bloque";
}

<h2>Crear Bloque</h2>

<form asp-action="Create">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">

        <label asp-for="Nombre" class="form-label"></label>

        <input asp-for="Nombre"
               class="form-control" />

        <span asp-validation-for="Nombre"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="Descripcion"
               class="form-label"></label>

        <input asp-for="Descripcion"
               class="form-control" />

    </div>

    <div class="mb-3">

        <label asp-for="CantidadPisos"
               class="form-label"></label>

        <input asp-for="CantidadPisos"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-success">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Volver
    </a>

</form>
